# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
firebase-debug.log
firestore-debug.log

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# secrets / service accounts
# Firebase downloads admin keys as <project>-firebase-adminsdk-<hash>-<hash>.json,
# which is why the adminsdk pattern is here as well as the generic ones.
*firebase-adminsdk*.json
*-service-account*.json
serviceAccountKey.json
.secrets/

# firebase tooling
.firebase/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android